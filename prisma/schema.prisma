// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Models

model Tag {
  id              Int              @id @default(autoincrement())
  name            String           @unique
  contacts        Contact[]
  campaignTargets CampaignTarget[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@map("tags")
}

model Contact {
  id              Int       @id @default(autoincrement())
  firstName       String
  lastName        String
  email           String?
  phone           String?
  clickid         String?
  subscribed      Boolean?
  lastMessageSent DateTime?
  tags            Tag[]     // Changed from String[] to Tag relation
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("contacts")
}

model Campaign {
  id              Int              @id @default(autoincrement())
  name            String
  shortlinks      Shortlink[]
  lastMessageSent DateTime?
  targets         CampaignTarget[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@map("campaigns")
}

model CampaignTarget {
  id          Int       @id @default(autoincrement())
  campaign    Campaign  @relation(fields: [campaignId], references: [id])
  campaignId  Int
  targetType  String    // Either "TAG" or "ALL_SUBSCRIBED"
  tagId       Int?      // Only used when targetType is "TAG"
  tag         Tag?      @relation(fields: [tagId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("campaign_targets")
}

model Shortlink {
  id          Int       @id @default(autoincrement())
  slug        String    @unique
  destination String
  clicks      Int       @default(0)
  campaign    Campaign? @relation(fields: [campaignId], references: [id])
  campaignId  Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("shortlinks")
} 