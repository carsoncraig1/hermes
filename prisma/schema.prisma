// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// Auth Models (NextAuth.js)
// ============================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?   // For credentials provider (hashed)
  
  // Relations to app data
  accounts      Account[]
  sessions      Session[]
  contacts      Contact[]
  campaigns     Campaign[]
  tags          Tag[]
  numbers       Number[]
  shortlinks    Shortlink[]
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================
// App Models
// ============================================

model Tag {
  id              Int              @id @default(autoincrement())
  name            String
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  contacts        Contact[]
  campaignTargets CampaignTarget[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([name, userId]) // Tag names unique per user
  @@map("tags")
}

model Contact {
  id              Int       @id @default(autoincrement())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName       String
  lastName        String
  email           String?
  phone           String?
  clickid         String?
  subscribed      Boolean?
  lastMessageSent DateTime?
  tags            Tag[]
  numbers         Number[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("contacts")
}

model Campaign {
  id              Int              @id @default(autoincrement())
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  message         String           @default("")
  shortlinks      Shortlink[]
  lastMessageSent DateTime?
  targets         CampaignTarget[]
  numbers         Number[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@map("campaigns")
}

model CampaignTarget {
  id          Int       @id @default(autoincrement())
  campaign    Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignId  Int
  targetType  String    // Either "TAG" or "ALL_SUBSCRIBED"
  tagId       Int?      // Only used when targetType is "TAG"
  tag         Tag?      @relation(fields: [tagId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("campaign_targets")
}

model Shortlink {
  id          Int       @id @default(autoincrement())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug        String    @unique
  destination String
  clicks      Int       @default(0)
  enabled     Boolean   @default(true)
  campaign    Campaign? @relation(fields: [campaignId], references: [id])
  campaignId  Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("shortlinks")
}

model Number {
  id          Int        @id @default(autoincrement())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  phoneNumber String     @unique
  status      String     @default("ACTIVE") // ACTIVE, INACTIVE, etc.
  contacts    Contact[]
  campaigns   Campaign[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("numbers")
}
