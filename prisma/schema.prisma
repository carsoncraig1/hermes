// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

// ============================================
// Auth Models (NextAuth.js)
// ============================================

model User {
  id                       String    @id @default(cuid())
  name                     String?
  email                    String    @unique
  emailVerified            DateTime?
  image                    String?
  password                 String? // For credentials provider (hashed)
  apiKey                   String?   @unique // Hermes API key for external API access
  standardOptOutText       String? // Standard opt-out language to append to messages
  timezone                 String? // Preferred IANA timezone used for scheduling UI
  telnyxApiKey             String? // Telnyx API key for SMS sending
  telnyxPhoneNumber        String? // Telnyx phone number to use as sender
  telnyxMessagingProfileId String? // Telnyx messaging profile ID
  autoUnsubscribeOnFailure Boolean   @default(true) // Automatically unsubscribe contacts on delivery failures

  // Relations to app data
  accounts                    Account[]
  sessions                    Session[]
  contacts                    Contact[]
  campaigns                   Campaign[]
  tags                        Tag[]
  shortlinks                  Shortlink[]
  consoleLogs                 ConsoleLog[]
  messages                    Message[]
  revenueEvents               RevenueEvent[]
  messageClickCodes           MessageClickCode[]
  sendJobs                    SendJob[]
  delayedWorkflowActions      DelayedWorkflowAction[]
  rateLimitCache              RateLimitCache?
  scheduledShortlinkRedirects ScheduledShortlinkRedirect[]
  spamFilterEvents            SpamFilterEvent[]
  phoneNumbers                PhoneNumber[]
  mediaAssets                 MediaAsset[]
  costReportDays              CostReportDay[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([telnyxMessagingProfileId])
  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================
// App Models
// ============================================

model Tag {
  id              Int              @id @default(autoincrement())
  name            String
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  contacts        Contact[]
  campaignTargets CampaignTarget[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([name, userId]) // Tag names unique per user
  @@map("tags")
}

model Contact {
  id                     Int                     @id @default(autoincrement())
  userId                 String
  user                   User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName              String?
  lastName               String?
  email                  String?
  phone                  String // Required - used for deduplication
  clickid                String[]                @default([]) // Array of click IDs
  source                 String? // Changed from tag to source
  age                    String?
  ip                     String?
  useragent              String?
  referrer               String?
  subscribed             Boolean?
  unsubscribeReason      String? // Reason for unsubscription: "STOP", "delivery_failed", "sending_failed", "manual", etc.
  lastMessageSent        DateTime?
  hasClicked             Boolean                 @default(false) // Whether this contact has clicked on any links in messages
  assignedPhoneNumberId  Int?
  assignedPhoneNumber    PhoneNumber?            @relation(fields: [assignedPhoneNumberId], references: [id], onDelete: SetNull)
  tags                   Tag[]
  messages               Message[]
  messageClickCodes      MessageClickCode[]
  delayedWorkflowActions DelayedWorkflowAction[]
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  @@index([userId, subscribed])
  @@index([userId, createdAt])
  @@index([userId, updatedAt])
  @@map("contacts")
}

model PhoneNumber {
  id                   Int         @id @default(autoincrement())
  userId               String
  user                 User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  phoneNumber          String
  friendlyName         String?
  type                 String      @default("toll_free")
  messagingProfileId   String?
  enabled              Boolean     @default(true)
  acceptingNewLeads    Boolean     @default(true)
  rateLimit            Int         @default(1200)
  currentMonthMessages Int         @default(0)
  mediaAssetId         String? // Optional .vcf contact card attached when sending from this number
  mediaAsset           MediaAsset? @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)
  contacts             Contact[]
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  @@unique([userId, phoneNumber])
  @@index([userId, enabled])
  @@index([userId, acceptingNewLeads])
  @@index([messagingProfileId])
  @@index([mediaAssetId])
  @@map("phone_numbers")
}

model Campaign {
  id                    Int                     @id @default(autoincrement())
  userId                String
  user                  User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                  String
  message               String                  @default("") // Legacy field, kept for backward compatibility
  workflow              Json? // Workflow definition (nodes, edges, etc.)
  enabled               Boolean                 @default(true)
  attachVcf             Boolean                 @default(false) // Attach the sending number's .vcf contact card (sends as MMS)
  messagesSent          Int                     @default(0) // Total number of messages sent
  totalRevenue          Decimal                 @default(0) @db.Decimal(10, 2) // Total revenue from this campaign
  shortlinks            Shortlink[]
  messages              Message[]
  revenueEvents         RevenueEvent[]
  lastMessageSent       DateTime?
  targets               CampaignTarget[] // Legacy targeting, kept for backward compatibility
  sendJobs              SendJob[]
  spamFilterEvents      SpamFilterEvent[]
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  DelayedWorkflowAction DelayedWorkflowAction[]

  @@map("campaigns")
}

model MediaAsset {
  id          String  @id @default(cuid())
  userId      String
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind        String  @default("vcard") // vcard | image (future-proofing for other MMS media)
  contentType String // MIME type served to Telnyx (e.g. "text/vcard")
  content     String  @db.Text // Raw media bytes/text, served from /api/media/[id]/card.vcf (no external storage)
  sizeBytes   Int
  label       String? // User-facing name (e.g. "My business card")
  source      String  @default("generated") // generated | uploaded
  vcardData   Json? // Structured vCard fields when generated (enables re-editing)

  messages     Message[]
  phoneNumbers PhoneNumber[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@map("media_assets")
}

model CampaignTarget {
  id          Int      @id @default(autoincrement())
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignId  Int
  targetType  String // Either "TAG", "SOURCE", or "ALL_SUBSCRIBED"
  tagId       Int? // Only used when targetType is "TAG"
  tag         Tag?     @relation(fields: [tagId], references: [id])
  sourceValue String? // Only used when targetType is "SOURCE"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("campaign_targets")
}

model Shortlink {
  id                Int                @id @default(autoincrement())
  userId            String
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String             @default("dynamic") // "dynamic" or "legacy"
  nickname          String? // Optional nickname for the shortlink (used for identification in UI)
  slug              String?            @unique // 3-character slug for legacy shortlinks (e.g., "abc")
  destination       String
  clicks            Int                @default(0) // Counter for total clicks
  opens             Int                @default(0) // Tracks preview fetches from messaging apps
  enabled           Boolean            @default(true)
  campaign          Campaign?          @relation(fields: [campaignId], references: [id])
  campaignId        Int?
  // OG Preview fields
  ogEnabled         Boolean            @default(false)
  ogImage           String?
  ogTitle           String?
  ogDescription     String?
  revenueEvents     RevenueEvent[]
  clickRecords      ShortlinkClick[] // Individual click tracking with unique HRMS
  messageClickCodes MessageClickCode[] // Click codes for messages containing this shortlink
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  scheduledRedirects ScheduledShortlinkRedirect[] // Scheduled redirect changes

  @@index([slug]) // Index for legacy shortlink lookups
  @@map("shortlinks")
}

// Scheduled shortlink redirect changes
model ScheduledShortlinkRedirect {
  id             Int       @id @default(autoincrement())
  shortlinkId    Int
  shortlink      Shortlink @relation(fields: [shortlinkId], references: [id], onDelete: Cascade)
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  newDestination String    @db.Text
  scheduledAt    DateTime // When to change the redirect
  status         String    @default("pending") // pending, completed, cancelled
  executedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, scheduledAt]) // For finding redirects ready to execute
  @@index([shortlinkId])
  @@map("scheduled_shortlink_redirects")
}

model MessageClickCode {
  id              Int              @id @default(autoincrement())
  code            String           @unique // 5-6 character alphanumeric code (base62)
  shortlinkId     Int
  shortlink       Shortlink        @relation(fields: [shortlinkId], references: [id], onDelete: Cascade)
  messageId       String
  message         Message          @relation(fields: [messageId], references: [id], onDelete: Cascade)
  contactId       Int?
  contact         Contact?         @relation(fields: [contactId], references: [id], onDelete: SetNull)
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  clicked         Boolean          @default(false) // Whether this code has been clicked
  clickedAt       DateTime? // When the code was first clicked
  opened          Boolean          @default(false) // Whether this code has been opened (preview fetched by bot)
  openedAt        DateTime? // When the code was first opened (preview fetched)
  expiresAt       DateTime // Code expires after 30 days
  shortlinkClicks ShortlinkClick[] // Clicks that used this code
  createdAt       DateTime         @default(now())

  @@index([code]) // Primary lookup index
  @@index([shortlinkId, createdAt])
  @@index([messageId])
  @@index([contactId])
  @@index([userId, expiresAt]) // For cleanup queries
  @@map("message_click_codes")
}

model ShortlinkClick {
  id                 Int               @id @default(autoincrement())
  shortlinkId        Int
  shortlink          Shortlink         @relation(fields: [shortlinkId], references: [id], onDelete: Cascade)
  messageId          String? // Link to the specific message that contained this shortlink
  message            Message?          @relation(fields: [messageId], references: [id], onDelete: SetNull)
  messageClickCodeId Int? // Link to the MessageClickCode that was used
  messageClickCode   MessageClickCode? @relation(fields: [messageClickCodeId], references: [id], onDelete: SetNull)
  hrms               String?           @unique // Unique tracking parameter for this specific click (optional for legacy shortlinks)
  userAgent          String? // User agent string for analytics
  ipAddress          String? // IP address for analytics
  referrer           String? // Referrer URL
  revenueEvents      RevenueEvent[] // Revenue events attributed to this click
  createdAt          DateTime          @default(now())

  @@index([shortlinkId, createdAt])
  @@index([messageId, createdAt])
  @@index([hrms])
  @@index([messageClickCodeId])
  @@map("shortlink_clicks")
}

// Durable per-day cache for /api/cost-report. A settled UTC day's cost slice
// is immutable, so it is computed once and persisted — replacing the
// per-container in-memory cache that was lost on every deploy/restart and
// forced 100s+ recomputes of heavy historical days.
model CostReportDay {
  id         Int      @id @default(autoincrement())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  day        String // UTC day, 'YYYY-MM-DD'
  body       Json // Raw combined-scan rows for the day (name-free; names attached at read time)
  computedAt DateTime @default(now())

  @@unique([userId, day])
  @@map("cost_report_days")
}

model ConsoleLog {
  id        Int      @id @default(autoincrement())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  level     String // info, warn, error, debug
  message   String   @db.Text
  meta      Json? // Additional metadata
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("console_logs")
}

model Message {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  telnyxMessageId String?   @unique // Message ID from Telnyx API
  contactId       Int?
  contact         Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  campaignId      Int?
  campaign        Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  // Message details
  from  String // Sender phone number
  to    String // Recipient phone number
  text  String @db.Text // Message content
  type  String @default("SMS") // SMS or MMS
  parts Int    @default(1) // Number of message parts (for concatenated messages)

  // MMS media (e.g. .vcf contact cards). mediaUrls is a snapshot of what was sent,
  // so it survives deletion of the underlying MediaAsset.
  mediaAssetId String?
  mediaAsset   MediaAsset? @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)
  mediaUrls    Json? // Array of media URLs actually sent to Telnyx

  // Status tracking
  status    String @default("queued") // queued, sending, sent, delivered, sending_failed, delivery_failed, delivery_unconfirmed
  direction String @default("outbound") // outbound or inbound

  // Cost tracking
  costAmount   Decimal? @db.Decimal(10, 4) // Cost in USD
  costCurrency String   @default("USD")

  // Timestamps
  sentAt      DateTime?
  deliveredAt DateTime?
  failedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Additional metadata
  telnyxMetadata    Json? // Store full Telnyx response for debugging
  errorMessage      String?            @db.Text // Error message if failed
  messageClickCodes MessageClickCode[] // Click codes generated for shortlinks in this message
  shortlinkClicks   ShortlinkClick[] // Clicks on shortlinks in this message
  spamFilterEvents  SpamFilterEvent[]

  @@index([userId, createdAt])
  @@index([userId, direction, status, createdAt])
  @@index([userId, direction, createdAt])
  @@index([contactId])
  @@index([campaignId])
  @@index([status])
  @@index([telnyxMessageId])
  @@index([mediaAssetId])
  @@map("messages")
}

model SpamFilterEvent {
  id                Int       @id @default(autoincrement())
  eventKey          String    @unique @map("event_key") // Idempotency key (e.g. telnyxMessageId:errorCode)
  userId            String    @map("user_id")
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaignId        Int?      @map("campaign_id")
  campaign          Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  messageId         String?   @map("message_id")
  message           Message?  @relation(fields: [messageId], references: [id], onDelete: SetNull)
  providerMessageId String?   @map("provider_message_id")
  fromNumber        String?   @map("from_number")
  toNumber          String?   @map("to_number")
  carrier           String?
  lineType          String?   @map("line_type")
  errorCode         String    @map("error_code")
  errorTitle        String?   @map("error_title")
  errorDetail       String?   @map("error_detail") @db.Text
  occurredAt        DateTime  @map("occurred_at")
  rawPayload        Json?     @map("raw_payload")
  createdAt         DateTime  @default(now()) @map("created_at")

  @@index([userId, occurredAt])
  @@index([userId, campaignId, occurredAt])
  @@index([userId, fromNumber, occurredAt])
  @@index([userId, toNumber, occurredAt])
  @@index([userId, errorCode, occurredAt])
  @@map("spam_filter_events")
}

model RevenueEvent {
  id               Int             @id @default(autoincrement())
  userId           String
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  hrms             String // Tracking parameter from shortlink click
  shortlinkId      Int?
  shortlink        Shortlink?      @relation(fields: [shortlinkId], references: [id], onDelete: SetNull)
  shortlinkClickId Int? // Link to the specific click that generated this revenue
  shortlinkClick   ShortlinkClick? @relation(fields: [shortlinkClickId], references: [id], onDelete: SetNull)
  campaignId       Int?
  campaign         Campaign?       @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  payout           Decimal         @db.Decimal(10, 2) // Revenue amount
  currency         String          @default("USD")
  metadata         Json? // Additional tracking data
  createdAt        DateTime        @default(now())

  @@index([userId, createdAt])
  @@index([hrms])
  @@index([campaignId, createdAt])
  @@index([shortlinkId, createdAt])
  @@index([shortlinkClickId])
  @@map("revenue_events")
}

// Background job queue for long-running sends
model SendJob {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaignId        Int
  campaign          Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  jobType           String // "dedicated_send" or "manual_fire"
  status            String    @default("pending") // pending, processing, completed, failed, cancelled
  totalContacts     Int       @default(0)
  processedContacts Int       @default(0)
  successCount      Int       @default(0)
  failCount         Int       @default(0)
  currentBatch      Int       @default(0)
  totalBatches      Int       @default(0)
  metadata          Json? // Additional job data (selectedTags, selectedSources, etc.)
  errorMessage      String?   @db.Text
  scheduledAt       DateTime? // When to execute this job (null = execute immediately)
  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([userId, status])
  @@index([campaignId, status])
  @@index([status, createdAt])
  @@index([status, scheduledAt]) // For finding scheduled jobs ready to execute
  @@map("send_jobs")
}

// Delayed workflow actions (replaces setTimeout)
model DelayedWorkflowAction {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaignId    Int?
  campaign      Campaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contactId     Int
  contact       Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  workflow      Json // Workflow definition
  currentNodeId String // Node ID to execute when delay expires
  executeAt     DateTime // When to execute this action
  status        String    @default("pending") // pending, processing, completed, failed, cancelled
  retryCount    Int       @default(0)
  errorMessage  String?   @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status, executeAt]) // For finding actions ready to execute
  @@index([contactId])
  @@index([campaignId])
  @@map("delayed_workflow_actions")
}

// Rate limit cache for optimization
model RateLimitCache {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  minuteCount Int      @default(0)
  hourCount   Int      @default(0)
  lastUpdated DateTime @default(now())
  expiresAt   DateTime // Cache expires after 10 seconds

  @@unique([userId]) // One cache entry per user
  @@index([expiresAt]) // For cleanup
  @@map("rate_limit_cache")
}
