// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// Auth Models (NextAuth.js)
// ============================================

model User {
  id                  String    @id @default(cuid())
  name                String?
  email               String    @unique
  emailVerified       DateTime?
  image               String?
  password            String?   // For credentials provider (hashed)
  apiKey              String?   @unique // Hermes API key for external API access
  standardOptOutText  String?   // Standard opt-out language to append to messages
  
  // Relations to app data
  accounts            Account[]
  sessions            Session[]
  contacts            Contact[]
  campaigns           Campaign[]
  tags                Tag[]
  shortlinks          Shortlink[]
  consoleLogs         ConsoleLog[]
  
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================
// App Models
// ============================================

model Tag {
  id              Int              @id @default(autoincrement())
  name            String
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  contacts        Contact[]
  campaignTargets CampaignTarget[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([name, userId]) // Tag names unique per user
  @@map("tags")
}

model Contact {
  id              Int       @id @default(autoincrement())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName       String?
  lastName        String?
  email           String?
  phone           String    // Required - used for deduplication
  clickid         String[]  @default([]) // Array of click IDs
  source          String?   // Changed from tag to source
  age             String?
  ip              String?
  useragent       String?
  referrer        String?
  subscribed      Boolean?
  lastMessageSent DateTime?
  tags            Tag[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("contacts")
}

model Campaign {
  id              Int              @id @default(autoincrement())
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  message         String           @default("") // Legacy field, kept for backward compatibility
  workflow        Json?            // Workflow definition (nodes, edges, etc.)
  enabled         Boolean          @default(true)
  messagesSent    Int              @default(0) // Total number of messages sent
  shortlinks      Shortlink[]
  lastMessageSent DateTime?
  targets         CampaignTarget[] // Legacy targeting, kept for backward compatibility
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@map("campaigns")
}

model CampaignTarget {
  id          Int       @id @default(autoincrement())
  campaign    Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignId  Int
  targetType  String    // Either "TAG", "SOURCE", or "ALL_SUBSCRIBED"
  tagId       Int?      // Only used when targetType is "TAG"
  tag         Tag?      @relation(fields: [tagId], references: [id])
  sourceValue String?   // Only used when targetType is "SOURCE"
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("campaign_targets")
}

model Shortlink {
  id            Int       @id @default(autoincrement())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  nickname      String?   // Optional nickname for the shortlink
  slug          String    @unique
  destination   String
  clicks        Int       @default(0)
  opens         Int       @default(0)  // Tracks preview fetches from messaging apps
  enabled       Boolean   @default(true)
  campaign      Campaign? @relation(fields: [campaignId], references: [id])
  campaignId    Int?
  // OG Preview fields
  ogEnabled     Boolean   @default(false)
  ogImage       String?
  ogTitle       String?
  ogDescription String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("shortlinks")
}

model ConsoleLog {
  id        Int      @id @default(autoincrement())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  level     String   // info, warn, error, debug
  message   String   @db.Text
  meta      Json?    // Additional metadata
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("console_logs")
}

